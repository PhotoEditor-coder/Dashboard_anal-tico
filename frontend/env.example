# Configuración del Dashboard Analítico
# Copia este archivo como .env y ajusta los valores

# URL de la API Backend
REACT_APP_API_URL=http://localhost/dashboard_analitico/backend/api

# Puerto del servidor de desarrollo (opcional)
# PORT=3000

# Configuración de la base de datos (para referencia)
# DB_HOST=localhost
# DB_NAME=dashboard_db
# DB_USER=root
# DB_PASS=
